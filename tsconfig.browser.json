{
  "compilerOptions": {
    "target": "ES2020",
    "module": "none",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "dist/assets/js",
    "noEmitOnError": true
  },
  "include": ["src/**/*.ts", "types/**/*.d.ts"],
  "exclude": ["src/proxy-server.ts"]
}
